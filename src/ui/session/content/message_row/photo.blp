using Gtk 4.0;

template $PaplMessagePhoto : $PaplMessageBase {
  layout-manager: BinLayout {};

  $PaplMessageBubble message_bubble {
    styles ["media"]

    prefix: Overlay {
      GestureClick click {
        button: 1;
      }

      $PaplMessageMediaPicture picture {
      }

      [overlay]
      $PaplMediaDownloadButton download_button {
        halign: center;
        valign: center;
      }
    };
  }
}
