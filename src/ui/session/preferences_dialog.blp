using Gtk 4.0;
using Adw 1;

template $PaplPreferencesDialog : Adw.PreferencesDialog {
  Adw.PreferencesPage {
    Adw.PreferencesGroup {
      title: _("General");

      Adw.ActionRow {
        title: _("Run in Background");
        subtitle: _("Keep receiving notifications after closing the window");
        activatable-widget: run_in_background_switch;

        Switch run_in_background_switch {
          valign: center;
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Color Scheme");

      Adw.ActionRow {
        title: _("Follow System Colors");
        activatable-widget: follow_system_colors_switch;

        Switch follow_system_colors_switch {
          valign: center;
        }
      }

      Adw.ActionRow {
        title: _("Dark Theme");
        activatable-widget: dark_theme_switch;

        Switch dark_theme_switch {
          valign: center;
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Media");

      Adw.ActionRow {
        title: _("Auto-Download Media");
        activatable-widget: auto_download_media_switch;

        Switch auto_download_media_switch {
          valign: center;
        }
      }

      Adw.ActionRow {
        title: _("Photos");
        activatable-widget: auto_download_photos_switch;

        Switch auto_download_photos_switch {
          valign: center;
        }
      }

      Adw.ActionRow {
        title: _("Videos");
        activatable-widget: auto_download_videos_switch;

        Switch auto_download_videos_switch {
          valign: center;
        }
      }

      Adw.SpinRow auto_download_videos_max_size_spin {
        title: _("Maximum Video Size");

        [suffix]
        Label {
          label: _("MB");

          styles ["dim-label"]
        }
      }

      Adw.ActionRow {
        title: _("Files");
        activatable-widget: auto_download_files_switch;

        Switch auto_download_files_switch {
          valign: center;
        }
      }

      Adw.SpinRow auto_download_files_max_size_spin {
        title: _("Maximum File Size");

        [suffix]
        Label {
          label: _("MB");

          styles ["dim-label"]
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Storage");

      Adw.ActionRow {
        title: _("Cache Size");

        Label cache_size_label {
          styles ["dim-label"]
        }
      }

      Button {
        styles ["pill"]

        label: _("Clear Cache");
        action-name: "preferences.clear-cache";
        halign: center;
        margin-top: 24;
      }
    }
  }
}
